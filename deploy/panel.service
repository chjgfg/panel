# 让面板本身开机自启。装法：
#
#   mkdir -p /opt/panel /opt/apps
#   install -m 755 target/release/panel /opt/panel/panel
#   install -m 600 panel.toml           /opt/panel/panel.toml
#   cp deploy/panel.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now panel
#
# /opt/apps 就是放项目的地方（配置里的 dirs）。以后加项目就一句：
#   cd /opt/apps && git clone <你的仓库>
# 刷新网页就能看到它，点「运行…」选一个 bin 填上参数就跑起来了。
#
# 面板自己的日志：journalctl -u panel -f
# 某个项目的日志：journalctl -u panel-<项目文件夹名> -f
# 放行端口：ufw allow 80   （云服务器还要开安全组）

[Unit]
Description=项目面板
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# 用 root 跑，这样面板直接调 systemd-run / systemctl，不用额外配 sudo 授权
User=root
# 配置不用在这里指定：panel 会自动找自己旁边的 panel.toml
ExecStart=/opt/panel/panel
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
