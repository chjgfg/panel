# 改好后重命名成 panel.toml，放在 panel 旁边或项目根目录都行。
# 面板启动时按这个顺序找：PANEL_CONFIG > ./panel.toml > panel 旁边的 > /etc/panel.toml
#
# 里面有明文密码，记得 chmod 600 panel.toml

# 直接监听公网口，浏览器打开 http://你的服务器IP:8080
bind = "0.0.0.0:8080"

# 明文密码，至少 12 位。面板是裸挂在公网上的，
# 设成 123456 这种几小时内就会被扫到并试出来。生成一个随机的：
#   openssl rand -base64 24
password = "换成你自己的长随机密码"

# 放项目的目录，可以写多个。面板每次刷新都重新扫一遍，
# 里面每个子文件夹算一个项目。新增项目只要建（或 git clone）一个文件夹，
# 刷新网页就能看到，不用改这个文件，也不用重启面板。
dirs = ["/opt/apps"]

# 不想在页面上看到的项目。三种写法，可以混用：
#   "scratch"              项目名，任何扫描目录下叫这个的都排掉
#   "test-*"  "*-old"      通配符，只支持 *
#   "/opt/apps/legacy"     带 / 就按完整路径匹配，只排掉这一个
# 排掉的项目在页面上看不到，接口上也操作不了（返回 404）。
# 面板自己那个项目不用写，会自动排除。
exclude = []

# cargo 的绝对路径。留空会自动探测（$HOME/.cargo/bin、/root/.cargo/bin、
# /usr/local/bin、/usr/bin）。探测不到时启动会直接报错，那就在这里写死。
# 查路径：which cargo
#cargo = "/root/.cargo/bin/cargo"
